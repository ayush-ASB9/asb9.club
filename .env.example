# Public endpoint URL included in the static site build (not a secret).
VITE_APPLICATION_API_URL=https://your-worker.your-account.workers.dev/api/application

# Google Apps Script web app URL (ends in /exec) that writes each Cohort 01
# application to a Google Sheet. Setup: google-sheet/README.md. Leave unset and
# the form says nothing was sent.
VITE_COHORT_APPLICATION_URL=

# Cloudflare Worker runtime configuration. Set these in wrangler.jsonc or
# Worker secrets; do not put the Resend API key into frontend build settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ASB9 CLUB <applications@asb9.club>
ALLOWED_ORIGIN=https://asb9.club
